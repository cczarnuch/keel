#!/bin/bash
# Steam on Mac will not spawn a script. Launch Options must start with /bin/bash
# and pass this file. This finds python3 and runs keel.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PY=""
if [ -n "${KEEL_PYTHON:-}" ] && [ -x "${KEEL_PYTHON}" ]; then
  PY="$KEEL_PYTHON"
elif command -v python3 >/dev/null 2>&1; then
  PY="$(command -v python3)"
elif [ -x /usr/bin/python3 ]; then
  PY="/usr/bin/python3"
elif [ -x /opt/homebrew/bin/python3 ]; then
  PY="/opt/homebrew/bin/python3"
elif [ -x /usr/local/bin/python3 ]; then
  PY="/usr/local/bin/python3"
fi
if [ -z "$PY" ]; then
  echo "Keel needs Python 3. Install Xcode Command Line Tools, then try again." >&2
  exit 1
fi
exec "$PY" "$HERE/keel" waitforexitandrun "$@"
