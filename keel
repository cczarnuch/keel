def cache_dir() -> Path:
    raw = os.environ.get("KEEL_CACHE_DIR", "")
    return Path(raw).expanduser() if raw else Path.home() / "Library" / "Caches" / "Keel"


def cx_src_dir() -> Path:
    raw = os.environ.get("KEEL_CX_SRC", "")
    return Path(raw).expanduser() if raw else Path.home() / "Downloads" / "sources"


def proton_src_dir() -> Path:
    raw = os.environ.get("KEEL_PROTON_SRC", "") or os.environ.get("PROTON_SRC", "")
    return Path(raw).expanduser() if raw else Path.home() / "src" / "proton"


def wine_patches() -> list[Path]:
    return sorted((tool_dir() / "wine-patches").glob("000[1-6]-*.patch"))


def patch_state(wine: Path, patch: Path) -> str:
    """'applied', 'clean' (applies), or 'conflict'."""
    def ok(*extra: str) -> bool:
        return subprocess.run(["patch", "-p1", "-f", "-s", "--dry-run", *extra, "-i", str(patch)],
                              cwd=wine, capture_output=True).returncode == 0
    if ok("-R"):
        return "applied"
    return "clean" if ok() else "conflict"


def cx_src_status() -> tuple[bool, list[str], list[str]]:
    """(wine tree present, applied patch names, not-applied patch names)."""
    wine = cx_src_dir() / "wine"
    if not (wine / "configure.ac").is_file():
        return False, [], []
    applied, missing = [], []
    for patch in wine_patches():
        (applied if patch_state(wine, patch) == "applied" else missing).append(patch.name)
    return True, applied, missing


def apply_wine_patches(wine: Path) -> int:
    failures = 0
    for patch in wine_patches():
        if patch.name.startswith("0003") and not (wine / "dlls" / "lsteamclient" / "unixlib.cpp").is_file():
            proton = proton_src_dir() / "lsteamclient"
            if not proton.is_dir():
                log(f"skip {patch.name}: needs Proton's lsteamclient/ (proton_11.0 @ bc89621) at {proton};"
                    " set KEEL_PROTON_SRC and re-run")
                failures += 1
                continue
            log(f"copying {proton} -> {wine / 'dlls' / 'lsteamclient'}")
            shutil.copytree(proton, wine / "dlls" / "lsteamclient", dirs_exist_ok=True)
        state = patch_state(wine, patch)
        if state == "applied":
            log(f"already applied: {patch.name}")
        elif state == "clean":
            subprocess.run(["patch", "-p1", "-f", "-s", "-i", str(patch)], cwd=wine, check=True)
            log(f"applied: {patch.name}")
        else:
            log(f"DOES NOT APPLY: {patch.name}")
            failures += 1
    return failures


def fetch_crossover_src(argv: list[str]) -> int:
    version = argv[2] if len(argv) > 2 else CX_SRC_VERSION
    url = CX_SRC_URL.format(version=version)
    archive = cache_dir() / f"crossover-sources-{version}.tar.gz"
    dest = cx_src_dir()
    wine = dest / "wine"
    if os.environ.get("KEEL_DRY_RUN", "") == "1":
        log(f"dry run: download {url} -> {archive} (curl -C -, resumable)")
        log(f"dry run: verify with tar -tzf, print sha256; unpack to {dest}")
        log(f"dry run: patch {wine} with " + ", ".join(p.name for p in wine_patches())
            + f" (0003 copies lsteamclient/ from {proton_src_dir()})")
        return 0
    if not (wine / "configure.ac").is_file():
        archive.parent.mkdir(parents=True, exist_ok=True)
        log(f"downloading {url}")
        if subprocess.run(["curl", "-fL", "-C", "-", "--retry", "3", "-o", str(archive), url]).returncode != 0:
            log(f"download failed; re-run to resume, or delete {archive}")
            return 1
        if subprocess.run(["tar", "-tzf", str(archive)], stdout=subprocess.DEVNULL).returncode != 0:
            log(f"{archive} is corrupt; delete it and retry")
            return 1
        import hashlib
        digest = hashlib.sha256()
        with open(archive, "rb") as handle:
            for chunk in iter(lambda: handle.read(1 << 20), b""):
                digest.update(chunk)
        log(f"sha256 {digest.hexdigest()}  {archive.name} (CodeWeavers publishes no checksum)")
        staging = cache_dir() / f"unpack-{version}"
        if staging.exists():
            shutil.rmtree(staging)
        staging.mkdir(parents=True)
        log(f"unpacking to {dest}")
        with tarfile.open(archive, "r:gz") as tar:
            safe_extract(tar, staging)
        top = staging / "sources"
        if not (top / "wine" / "configure.ac").is_file():
            log("archive has no sources/wine tree")
            return 1
        dest.mkdir(parents=True, exist_ok=True)
        for child in top.iterdir():
            if not (dest / child.name).exists():
                shutil.move(str(child), str(dest / child.name))
        shutil.rmtree(staging)
    else:
        log(f"sources present at {dest}")
    failures = apply_wine_patches(wine)
    log(f"wine tree: {wine} ({'patched' if not failures else f'{failures} patch(es) not applied'})")
    return 1 if failures else 0


def mac_steamclient() -> Path:
    forced = os.environ.get("KEEL_STEAMCLIENT_DYLIB", "")
    if forced:
        return Path(forced).expanduser()
    return (Path.home() / "Library" / "Application Support" / "Steam" / "Steam.AppBundle"
            / "Steam" / "Contents" / "MacOS" / "steamclient.dylib")


def dyld_paths() -> list[str]:
    raw = os.environ.get("KEEL_DYLD_PATH", "")
    paths = [p for p in raw.split(":") if p] if raw else [str(Path.home() / "opt" / "cxdeps-x86" / "lib")]
    return [str(Path(p).expanduser()) for p in paths]


def copy_if_changed(source: Path, target: Path) -> None:
    if target.is_file() and target.stat().st_size == source.stat().st_size \
            and target.stat().st_mtime >= source.stat().st_mtime:
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, target)
    log(f"staged {target.name}")


def stage_bridge(prefix: Path, wine: Path) -> None:
    steam_dir = prefix / "drive_c" / "Program Files (x86)" / "Steam"
    dll, _ = bridge_files(wine)
    copy_if_changed(dll, steam_dir / "steamclient64.dll")
    copy_if_changed(helpers_dir() / "keel_steam.exe", steam_dir / "keel_steam.exe")


def resolve_graphics(requested: str) -> str:
    if requested != "auto":
        return requested
    return "dxmt"


def dll_overrides(graphics: str, extra: str) -> str:
    table = {
        "dxmt": "d3d11,dxgi,d3d10core=n,b",
        "dxmt-runner": "d3d11,dxgi,d3d10core,winemetal=b",
        "dxvk": "d3d11,dxgi,d3d10core,d3d9=n,b",
        "d3dmetal": "d3d11,dxgi,d3d12,d3d10=b",
        "wined3d": "d3d11,dxgi,d3d12,d3d9=b",
    }
    parts = [table[graphics]] if graphics in table else []
    if extra:
        parts.append(extra)
    return ";".join(parts)


def to_windows_path(prefix: Path, unix_path: str) -> str:
    path = str(Path(unix_path).expanduser().resolve())
    drive_c = str((prefix / "drive_c").resolve())
    if path == drive_c or path.startswith(drive_c + os.sep):
        tail = path[len(drive_c) :].replace(os.sep, "\\")
        return "C:" + tail
    return "Z:" + path.replace(os.sep, "\\")


def to_unix_path(prefix: Path, windows_path: str) -> str:
    text = windows_path.replace("\\", "/")
    if len(text) >= 2 and text[1] == ":":
        letter = text[0].upper()
        tail = text[2:]
        if letter == "C":
            return str(prefix / "drive_c" / tail.lstrip("/"))
        if letter == "Z":
            return tail if tail.startswith("/") else "/" + tail
    return text


def refuse_dangerous(path: Path) -> Path:
    resolved = path.expanduser().resolve()
    home = Path.home().resolve()
    if resolved == home or resolved == Path("/") or home not in resolved.parents:
        raise SystemExit(f"refusing to delete {resolved}")
    return resolved


def command_args(argv: list[str]) -> list[str]:
    if len(argv) < 3:
        raise SystemExit("missing command")
    return argv[2:]


def prepare_and_launch(argv: list[str], applied: dict[str, str]) -> int:
    command = command_args(argv)
    runner_name = conf_get(applied, "KEEL_RUNNER", "runner", "auto")
    graphics = resolve_graphics(conf_get(applied, "KEEL_GRAPHICS", "graphics", "auto"))
    winver = conf_get(applied, "KEEL_WINVER", "winver", "win10")
    esync = conf_get(applied, "KEEL_ESYNC", "esync", "1")
    hud = conf_get(applied, "KEEL_HUD", "hud", "0")
    steamworks = conf_get(applied, "KEEL_STEAMWORKS", "steamworks", "direct")
    extra_dll = conf_get(applied, "KEEL_DLL", "dll", "")
    extra_args = conf_get(applied, "KEEL_ARGS", "args", "")

    variant, variant_key = graphics_runner(graphics)
    wine = variant if variant is not None else find_runner(runner_name)
    dxmt_runner = graphics == "dxmt" and variant is not None and runner_has_dxmt(variant)
    dry_run = os.environ.get("KEEL_DRY_RUN", "") == "1"
    prefix = prefix_path()
    if steamworks == "prefix" and steam_exe_path().is_file():
        prefix = steam_client_prefix()

    log(f"======== Keel {VERSION}  {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S')}Z")
    log(f"verb: {argv[1]}")
    log(f"appid: {appid() or '(none)'}")
    log(f"graphics: {graphics}")
    log(f"runner request: {runner_name}")
    if wine is None:
        log("no Wine runner found. Install CrossOver, Game Porting Toolkit, Whisky, or Homebrew wine.")
        for candidate in family_candidates(runner_name):
            log(f"  missing {candidate}")
        return 1
    log(f"wine: {wine} ({'from ' + variant_key if variant_key else 'KEEL_WINE/runner'})")
    log(f"prefix: {prefix}")

    bridge = steamworks == "bridge"
    if bridge:
        problems = bridge_problems(wine)
        if problems:
            log("steamworks=bridge is not ready:")
            for problem in problems:
                log(f"  {problem}")
            return 1
        extra = dyld_paths()
        current = [p for p in os.environ.get("DYLD_FALLBACK_LIBRARY_PATH", "").split(":") if p]
        fallback = extra + [p for p in current if p not in extra]
        for default in ("/usr/local/lib", "/usr/lib"):
            if default not in fallback:
                fallback.append(default)
        os.environ["DYLD_FALLBACK_LIBRARY_PATH"] = ":".join(fallback)
        aid_env = appid()
        if aid_env:
            os.environ.setdefault("SteamAppId", aid_env)
            os.environ.setdefault("SteamGameId", aid_env)

    if dry_run:
        if graphics == "dxmt" and dxmt_runner:
            backend = "runner builtins (d3d11,dxgi,d3d10core=b) + system32/winemetal.dll"
        elif graphics == "dxmt":
            backend = f"native staging from {dxmt_dll_dir()}"
        else:
            backend = dll_overrides(graphics, "")
        overrides = dll_overrides("dxmt-runner" if dxmt_runner else graphics, extra_dll)
        if bridge:
            overrides = ";".join(part for part in (overrides, "steamclient64=n,b") if part)
        launch = list(command) + (extra_args.split() if extra_args else [])
        if bridge:
            launch = [BRIDGE_STEAM_DIR + r"\keel_steam.exe", *launch]
        log(f"dry run: graphics={graphics} via {backend}")
        log(f"dry run: WINEDLLOVERRIDES={overrides}")
        log("dry run: command: " + " ".join([str(wine), *launch]))
        log("dry run: no prefix changes, Wine not started")
        return 0

    ensure_prefix(wine, prefix, winver)
    retina = conf_get(applied, "KEEL_RETINA", "retina", "1")
    if retina in ("0", "1"):
        apply_retina(wine, prefix, retina == "1")
    apply_dpi(wine, prefix, conf_get(applied, "KEEL_DPI", "dpi", ""))
    env = wine_env(wine, prefix)
    if esync == "1":
        env["WINEESYNC"] = "1"
        # CrossOver-derived runners (incl. Keel's Wine 11 build) implement fast sync as
        # mach-port "msync"; without it every wait/event is a wineserver round trip
        # (~8 us vs ~0.1 us), which starves multithreaded video decoders (P5R's CRI Mana).
        env.setdefault("WINEMSYNC", "1")
    env["ROSETTA_ADVERTISE_AVX"] = "1"
    env["MTL_HUD_ENABLED"] = "1" if hud == "1" else "0"
    env["DXMT_LOG_LEVEL"] = "info" if hud == "1" else "none"

    if graphics == "dxmt" and dxmt_runner:
        ensure_winemetal(prefix, wine)
        log(f"dxmt: runner builtins ({runner_root(wine)})")
    elif graphics == "dxmt":
        dlls = dxmt_dll_dir()
        if dlls is None:
            log("DXMT not installed; falling back to WineD3D. Run: keel fetch-dxmt")
            graphics = "wined3d"
        else:
            stage_native_dlls(prefix, dlls)
            log(f"dxmt: {dlls}")
    elif graphics == "dxvk":
        dxvk = support_dir() / "dxvk" / "x64"
        if (dxvk / "d3d11.dll").is_file():
            stage_native_dlls(prefix, dxvk)
        else:
            log("DXVK macOS build not in ~/Library/Application Support/Keel/dxvk/x64; using WineD3D")
            graphics = "wined3d"
    elif graphics == "d3dmetal":
        log("D3DMetal uses the runner's builtin. CrossOver or Game Porting Toolkit is required.")

    overrides = dll_overrides("dxmt-runner" if dxmt_runner else graphics, extra_dll)
    if bridge:
        stage_bridge(prefix, wine)
        overrides = ";".join(part for part in (overrides, "steamclient64=n,b") if part)
        log(f"steamworks: bridge (lsteamclient -> {mac_steamclient()})")
        log(f"DYLD_FALLBACK_LIBRARY_PATH={env.get('DYLD_FALLBACK_LIBRARY_PATH', '')}")
    env["WINEDLLOVERRIDES"] = overrides

    launch = list(command)
    aid = appid()
    if steamworks == "prefix" and aid:
        steam_exe = steam_exe_path()
        if steam_exe.is_file():
            ensure_shared_library(steam_exe.parent)
            launch = [str(steam_exe), "-applaunch", aid]
            log("steamworks: Windows Steam client -applaunch")
        else:
            log("steamworks=prefix but Windows Steam is not installed. Run: keel setup-steam")
    if extra_args:
        launch.extend(extra_args.split())
    if bridge:
        launch = [BRIDGE_STEAM_DIR + r"\keel_steam.exe", *launch]

    log("command: " + " ".join(launch))
    wine_log_setting = conf_get(applied, "KEEL_WINE_LOG", "wine_log", "1")
    wine_log = None
    if wine_log_setting == "1" and os.environ.get("STEAM_COMPAT_DATA_PATH"):
        log_path = Path(os.environ["STEAM_COMPAT_DATA_PATH"]) / "wine.log"
        try:
            wine_log = open(log_path, "w", encoding="utf-8")
            log(f"wine output: {log_path} (WINEDEBUG={env.get('WINEDEBUG', '')})")
        except OSError:
            wine_log = None
    try:
        proc = subprocess.Popen([str(wine), *launch], env=env, stdout=wine_log, stderr=wine_log)
        code = proc.wait()
    finally:
        if wine_log is not None:
            wine_log.close()
    wineserver = wine.parent / "wineserver"
    if executable(wineserver):
        subprocess.run([str(wineserver), "-w"], env=env, check=False)
    log(f"exit: {code}")
    return code


def ensure_shared_library(steam_install: Path) -> None:
    """Point Windows Steam at the Mac client's library folder, once."""
    mac_library = os.environ.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or str(
        Path.home() / "Library" / "Application Support" / "Steam"
    )
    folder = steam_install / "steamapps"
    folder.mkdir(parents=True, exist_ok=True)
    vdf = folder / "libraryfolders.vdf"
    win_path = "Z:" + str(Path(mac_library).resolve()).replace("/", "\\")
    if vdf.is_file():
        current = vdf.read_text(encoding="utf-8", errors="replace")
        if win_path in current:
            return
        log("libraryfolders.vdf already exists; leaving it untouched")
        return
    escaped = win_path.replace("\\", "\\\\")
    vdf.write_text(
        '"libraryfolders"\n{\n'
        '\t"0"\n\t{\n\t\t"path"\t\t"C:\\\\Program Files (x86)\\\\Steam"\n\t}\n'
        f'\t"1"\n\t{{\n\t\t"path"\t\t"{escaped}"\n\t}}\n'
        "}\n",
        encoding="utf-8",
    )
    log(f"linked Windows Steam library to {mac_library}")


def safe_extract(archive: tarfile.TarFile, destination: Path) -> None:
    destination = destination.resolve()
    for member in archive.getmembers():
        target = (destination / member.name).resolve()
        if destination != target and destination not in target.parents:
            raise SystemExit(f"refusing archive path {member.name}")
    archive.extractall(destination)


def fetch_dxmt() -> int:
    destination = support_dir() / "dxmt"
    destination.mkdir(parents=True, exist_ok=True)
    request = urllib.request.Request(
        "https://api.github.com/repos/3Shain/dxmt/releases/latest",
        headers={"User-Agent": "Keel", "Accept": "application/vnd.github+json"},
    )
    with urllib.request.urlopen(request, timeout=60) as response:
        payload = json.load(response)
    assets = payload.get("assets") or []
    chosen = None
    for asset in assets:
        name = asset.get("name", "").lower()
        if name.endswith((".tar.gz", ".tgz", ".zip")) and any(
            token in name for token in ("mac", "osx", "darwin", "macos")
        ):
            chosen = asset
            break
    if chosen is None:
        for asset in assets:
            if str(asset.get("name", "")).endswith(".tar.gz"):
                chosen = asset
                break
    if chosen is None:
        log("DXMT release has no archive asset")
        return 1
    url = chosen["browser_download_url"]
    archive_path = destination / chosen["name"]
    log(f"downloading {url}")
    urllib.request.urlretrieve(url, archive_path)
    extract_root = destination / "src"
    if extract_root.exists():
        shutil.rmtree(extract_root)
    extract_root.mkdir(parents=True)
    if archive_path.suffix == ".zip":
        import zipfile

        with zipfile.ZipFile(archive_path) as archive:
            archive.extractall(extract_root)
    else:
        with tarfile.open(archive_path, "r:*") as archive:
            safe_extract(archive, extract_root)
    found = sorted(extract_root.rglob("d3d11.dll"))
    dll = next((d for d in found if d.parent.name in ("x86_64-windows", "x64")), None)
    if dll is None:
        dll = next((d for d in found if "i386" not in str(d) and "x32" not in str(d)), found[0] if found else None)
    if dll is None:
        log("archive did not contain d3d11.dll")
        return 1
    (destination / "location.txt").write_text(str(dll.parent) + "\n", encoding="utf-8")
    log(f"DXMT ready at {dll.parent}")
    return 0


def setup_steam() -> int:
    wine = find_runner(os.environ.get("KEEL_RUNNER", "auto"))
    if wine is None:
        log("no Wine runner found")
        return 1
    prefix = support_dir() / "steam-client" / "pfx"
    ensure_prefix(wine, prefix, os.environ.get("KEEL_WINVER", "win10"))
    installer = support_dir() / "cache" / "SteamSetup.exe"
    installer.parent.mkdir(parents=True, exist_ok=True)
    if not installer.is_file():
        url = "https://cdn.akamai.steamstatic.com/client/installer/SteamSetup.exe"
        log(f"downloading {url}")
        urllib.request.urlretrieve(url, installer)
    env = wine_env(wine, prefix)
    log("launching the official Windows Steam installer")
    return subprocess.run([str(wine), str(installer)], env=env, check=False).returncode


def doctor() -> int:
    steam = Path.home() / "Library" / "Application Support" / "Steam"
    macos = steam / "Steam.AppBundle" / "Steam" / "Contents" / "MacOS"
    cfg = macos / "steam_dev.cfg"
    switch = False
    if cfg.is_file():
        switch = "sSteamCmdForcePlatformType" in cfg.read_text(encoding="utf-8", errors="replace")
    tool = steam / "compatibilitytools.d" / "keel-proton" / "keel"
    lines = [
        f"Keel {VERSION}",
        f"Steam: {'found' if steam.is_dir() else 'not installed'}",
        f"Tool files: {'installed' if tool.is_file() else 'not installed'}",
        f"Compatibility menu: not shown on Mac Steam. Use Launch Options.",
        f"Windows depot switch: {'on' if switch else 'off'}",
        f"Python: {sys.version.split()[0]}",
    ]
    forced = os.environ.get("KEEL_WINE", "")
    if forced:
        ok = forced_runner() is not None
        lines.append(f"KEEL_WINE (forces every launch): {forced}{'' if ok else '  [NOT EXECUTABLE]'}")
    saved = os.environ.pop("KEEL_WINE", None)
    try:
        for name in ("crossover", "gptk", "whisky", "wine"):
            found = find_runner(name)
            lines.append(f"{name}: {found if found else 'not found'}")
    finally:
        if saved is not None:
            os.environ["KEEL_WINE"] = saved
    problems = bridge_problems(find_runner("auto"))
    lines.append("Steamworks bridge: " + ("ready" if not problems else "not ready"))
    for problem in problems:
        lines.append(f"  {problem}")
    lines.extend(checklist_lines(bridge_checklist()))
    present, applied, missing = cx_src_status()
    if not present:
        lines.append(f"CrossOver sources: not found at {cx_src_dir()} (keel fetch-crossover-src)")
    else:
        state = "patched" if not missing else "missing " + ", ".join(m[:4] for m in missing)
        lines.append(f"CrossOver sources: {cx_src_dir()} ({state}; {len(applied)}/{len(applied) + len(missing)})")
    dlls = dxmt_dll_dir()
    lines.append(f"DXMT: {dlls if dlls else 'not installed (keel fetch-dxmt)'}")
    apps = sorted((support_dir() / "apps").glob("*.conf"))
    if apps:
        lines.append("Per-app graphics:")
    for conf in apps:
        values = load_conf(conf)
        graphics = values.get("KEEL_GRAPHICS", values.get("graphics", "auto (default)"))
        line = f"  {conf.stem}: {graphics}"
        variant = values.get({"dxmt": "KEEL_WINE_DXMT", "d3dmetal": "KEEL_WINE_D3DMETAL"}.get(graphics, ""), "")
        if variant:
            line += f"  runner {variant}"
        lines.append(line)
    text = "\n".join(lines)
    print(text)
    return 0


GRAPHICS_CHOICES = ("d3dmetal", "dxmt", "dxvk", "wined3d", "auto")


def graphics_command(argv: list[str]) -> int:
    if len(argv) < 3 or not argv[2].isdigit():
        sys.stderr.write("usage: keel graphics <appid> [" + "|".join(GRAPHICS_CHOICES) + "]\n")
        return 1
    conf = support_dir() / "apps" / f"{argv[2]}.conf"
    values = load_conf(conf)
    if len(argv) < 4:
        print(values.get("KEEL_GRAPHICS", values.get("graphics", "auto")))
        return 0
    choice = argv[3].lower()
    if choice not in GRAPHICS_CHOICES:
        sys.stderr.write(f"unknown backend {choice}; choose one of {', '.join(GRAPHICS_CHOICES)}\n")
        return 1
    lines = conf.read_text(encoding="utf-8").splitlines() if conf.is_file() else []
    backup = conf.with_name(conf.name + ".bak")
    if conf.is_file() and not backup.exists():
        shutil.copy2(conf, backup)
    out, done = [], False
    for line in lines:
        key = line.split("=", 1)[0].strip() if "=" in line and not line.lstrip().startswith("#") else ""
        if key in ("KEEL_GRAPHICS", "graphics"):
            if not done:
                out.append(f"KEEL_GRAPHICS={choice}")
                done = True
            continue
        out.append(line)
    if not done:
        out.append(f"KEEL_GRAPHICS={choice}")
    conf.parent.mkdir(parents=True, exist_ok=True)
    conf.write_text("\n".join(out) + "\n", encoding="utf-8")
    print(f"{argv[2]}: KEEL_GRAPHICS={choice}  ({conf})")
    return 0


