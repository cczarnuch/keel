#!/usr/bin/env python3
"""Keel — Steam Play compatibility tool for macOS.

Steam invokes this the way it invokes Proton:

    keel waitforexitandrun <windows-exe> [args...]

Logs go to stderr and to $STEAM_COMPAT_DATA_PATH/keel.log.
Path verbs print a single path on stdout and nothing else.
"""

from __future__ import annotations

import importlib.util
import json
import os
import shutil
import subprocess
import sys
import tarfile
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

VERSION = "0.14.0"
USAGE = """\
Keel {version} — Steam Play for macOS

  keel waitforexitandrun <exe> [args...]   launch and wait (Steam's verb)
  keel run <exe> [args...]                 launch and wait
  keel runinprefix <exe> [args...]         same, inside the prefix
  keel destroyprefix                       delete STEAM_COMPAT_DATA_PATH
  keel getcompatpath <unix-path>           print the Wine path
  keel getnativepath <windows-path>        print the macOS path
  keel setup-steam                         install the Windows Steam client
  keel fetch-dxmt                          download DXMT into Application Support
  keel doctor                              print what this Mac can run
  keel graphics <appid> [backend]          show or set KEEL_GRAPHICS for one game

  KEEL_STEAMWORKS=bridge  Proton-style lsteamclient bridge to Mac Steam (needs KEEL_WINE)
  KEEL_GRAPHICS=d3dmetal|dxmt|dxvk|wined3d|auto; KEEL_WINE_D3DMETAL / KEEL_WINE_DXMT
                          pick a runner variant per backend; KEEL_DRY_RUN=1 logs and exits
  keel version
""".format(version=VERSION)


def support_dir() -> Path:
    return Path.home() / "Library" / "Application Support" / "Keel"


def tool_dir() -> Path:
    return Path(__file__).resolve().parent


def ensure_compat_env() -> None:
    """Launch Options do not set STEAM_COMPAT_*. Fill them in from SteamAppId.

    The Mac client has no Compatibility page, so this is the normal path.
    """
    if os.environ.get("STEAM_COMPAT_DATA_PATH"):
        return
    aid = appid()
    if not aid:
        return
    steam = Path.home() / "Library" / "Application Support" / "Steam"
    os.environ["STEAM_COMPAT_DATA_PATH"] = str(steam / "steamapps" / "compatdata" / aid)
    os.environ.setdefault("STEAM_COMPAT_CLIENT_INSTALL_PATH", str(steam))
    os.environ.setdefault("STEAM_COMPAT_APP_ID", aid)


def log_file() -> Path | None:
    path = data_path()
    try:
        path.mkdir(parents=True, exist_ok=True)
    except OSError:
        return None
    return path / "keel.log"


def log(message: str) -> None:
    line = message.rstrip()
    print(line, file=sys.stderr)
    path = log_file()
    if path is None:
        return
    with path.open("a", encoding="utf-8") as handle:
        handle.write(line + "\n")


def load_user_settings(directory: Path) -> dict[str, str]:
    path = directory / "user_settings.py"
    if not path.is_file():
        return {}
    spec = importlib.util.spec_from_file_location("keel_user_settings", path)
    if spec is None or spec.loader is None:
        return {}
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    raw = getattr(module, "user_settings", {}) or {}
    return {str(key): str(value) for key, value in raw.items()}


def load_conf(path: Path) -> dict[str, str]:
    if not path.is_file():
        return {}
    values: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip()
    return values


def appid() -> str:
    for key in ("STEAM_COMPAT_APP_ID", "SteamAppId", "SteamGameId"):
        value = os.environ.get(key, "")
        if value.isdigit():
            return value
    data = os.environ.get("STEAM_COMPAT_DATA_PATH", "")
    name = Path(data).name if data else ""
    return name if name.isdigit() else ""


def apply_config() -> dict[str, str]:
    """user_settings.py, then per-app conf. Existing env wins."""
    merged: dict[str, str] = {}
    merged.update(load_user_settings(tool_dir()))
    aid = appid()
    if aid:
        merged.update(load_conf(tool_dir() / "apps" / f"{aid}.conf"))
        merged.update(load_conf(support_dir() / "apps" / f"{aid}.conf"))
    data = os.environ.get("STEAM_COMPAT_DATA_PATH")
    if data:
        merged.update(load_conf(Path(data) / "keel.conf"))
    applied: dict[str, str] = {}
    for key, value in merged.items():
        upper = key.upper()
        # lowercase conf keys are aliases, not exported verbatim
        if key.islower():
            applied[key] = value
            continue
        if upper not in os.environ:
            os.environ[upper] = value
        applied[upper] = os.environ.get(upper, value)
    return applied


def conf_get(applied: dict[str, str], env_key: str, conf_key: str, default: str) -> str:
    if conf_key in applied and env_key not in os.environ:
        return applied[conf_key]
    return os.environ.get(env_key, applied.get(env_key, applied.get(conf_key, default)))


def executable(path: Path) -> bool:
    return path.is_file() and os.access(path, os.X_OK)


def whisky_wines() -> list[Path]:
    roots = [
        Path.home() / "Library" / "Application Support" / "com.isaacmarovitz.Whisky",
        Path.home() / "Library" / "Application Support" / "Whisky",
    ]
    found: list[Path] = []
    for root in roots:
        if not root.is_dir():
            continue
        for path in root.glob("Libraries/**/bin/wine64"):
            if executable(path):
                found.append(path)
        for path in root.glob("Libraries/**/wine64"):
            if executable(path) and path not in found:
                found.append(path)
    return found


def family_candidates(runner: str) -> list[Path]:
    crossover = [
        Path("/Applications/CrossOver.app/Contents/SharedSupport/CrossOver/bin/wine64"),
        Path("/Applications/CrossOver.app/Contents/SharedSupport/CrossOver/bin/wine"),
    ]
    gptk = [
        Path("/usr/local/opt/game-porting-toolkit/bin/wine64"),
        Path("/usr/local/opt/game-porting-toolkit/bin/wine"),
        Path("/opt/homebrew/opt/game-porting-toolkit/bin/wine64"),
        Path("/opt/homebrew/opt/game-porting-toolkit/bin/wine"),
    ]
    brew = [
        Path("/opt/homebrew/bin/wine64"),
        Path("/opt/homebrew/bin/wine"),
        Path("/usr/local/bin/wine64"),
        Path("/usr/local/bin/wine"),
    ]
    groups = {
        "crossover": crossover,
        "gptk": gptk,
        "whisky": whisky_wines(),
        "wine": brew,
        "auto": crossover + gptk + whisky_wines() + brew,
    }
    return groups.get(runner, groups["auto"])


def forced_runner() -> Path | None:
    forced = os.environ.get("KEEL_WINE", "")
    if forced:
        path = Path(forced).expanduser()
        if executable(path):
            return path
    return None


def find_runner(runner: str) -> Path | None:
    forced = forced_runner()
    if forced is not None:
        return forced
    for candidate in family_candidates(runner):
        if executable(candidate):
            return candidate
    return None


def dxmt_dll_dir() -> Path | None:
    env = os.environ.get("KEEL_DXMT", "")
    candidates = []
    if env:
        candidates.append(Path(env))
    marker = support_dir() / "dxmt" / "location.txt"
    if marker.is_file():
        candidates.append(Path(marker.read_text(encoding="utf-8").strip()))
    candidates.append(support_dir() / "dxmt" / "x64")
    candidates.append(tool_dir() / "dxmt" / "x64")
    for directory in candidates:
        # 64-bit games need the x86_64 DLLs; never hand them i386-windows.
        if directory.name == "i386-windows" and (directory.parent / "x86_64-windows" / "d3d11.dll").is_file():
            return directory.parent / "x86_64-windows"
        for sub in ("x86_64-windows", "x64"):
            if (directory / sub / "d3d11.dll").is_file():
                return directory / sub
        if (directory / "d3d11.dll").is_file():
            return directory
    return None


def steam_client_prefix() -> Path:
    return support_dir() / "steam-client" / "pfx"


def steam_exe_path() -> Path:
    return steam_client_prefix() / "drive_c" / "Program Files (x86)" / "Steam" / "steam.exe"


def prefix_path() -> Path:
    data = os.environ.get("STEAM_COMPAT_DATA_PATH")
    if data:
        return Path(data) / "pfx"
    aid = appid() or "manual"
    return support_dir() / "compatdata" / aid / "pfx"


def data_path() -> Path:
    data = os.environ.get("STEAM_COMPAT_DATA_PATH")
    if data:
        return Path(data)
    return prefix_path().parent


def wine_env(wine: Path, prefix: Path) -> dict[str, str]:
    env = os.environ.copy()
    env["WINEPREFIX"] = str(prefix)
    env.setdefault("WINEDEBUG", "-all")
    bindir = str(wine.parent)
    env["PATH"] = bindir + os.pathsep + env.get("PATH", "")
    return env


def ensure_prefix(wine: Path, prefix: Path, winver: str) -> None:
    prefix.mkdir(parents=True, exist_ok=True)
    env = wine_env(wine, prefix)
    system = prefix / "system.reg"
    if not system.is_file():
        log(f"creating prefix {prefix}")
        subprocess.run([str(wine), "wineboot", "--init"], env=env, check=False)
    if prefix_incomplete(prefix):
        log("prefix looks incomplete (no services registered); running wineboot -u")
        subprocess.run([str(wine), "wineboot", "-u"], env=env, check=False)
    version_file = prefix.parent / "version"
    stamp = f"keel-{VERSION}-win{winver}"
    if version_file.is_file() and version_file.read_text(encoding="utf-8").strip() == stamp:
        return
    log(f"setting Windows version {winver}")
    subprocess.run(
        [str(wine), "reg", "add", r"HKCU\Software\Wine", "/v", "Version", "/d", winver, "/f"],
        env=env,
        check=False,
    )
    version_file.write_text(stamp + "\n", encoding="utf-8")


MAC_DRIVER_KEY = r"HKCU\Software\Wine\Mac Driver"


def apply_retina(wine: Path, prefix: Path, enabled: bool) -> None:
    """Set winemac RetinaMode so games see native pixels, not scaled points. Idempotent."""
    want = "y" if enabled else "n"
    user_reg = prefix / "user.reg"
    try:
        text = user_reg.read_text(encoding="utf-8", errors="replace")
    except OSError:
        text = ""
    section = "[Software\\\\Wine\\\\Mac Driver]"
    if section in text:
        block = text.split(section, 1)[1].split("\n[", 1)[0]
        if f'"RetinaMode"="{want}"' in block:
            return
    log(f"setting Mac Driver RetinaMode={want}")
    subprocess.run(
        [str(wine), "reg", "add", MAC_DRIVER_KEY, "/v", "RetinaMode", "/d", want, "/f"],
        env=wine_env(wine, prefix),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def prefix_incomplete(prefix: Path) -> bool:
    """A wineboot that was killed part-way leaves no service keys (RpcSs, nsiproxy...)."""
    try:
        text = (prefix / "system.reg").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    return "\\\\Services\\\\RpcSs]" not in text


def reg_value_is(prefix: Path, hive: str, section: str, entry: str) -> bool:
    try:
        text = (prefix / hive).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    marker = "[" + section.replace("\\", "\\\\") + "]"
    if marker not in text:
        return False
    block = text.split(marker, 1)[1].split("\n[", 1)[0]
    return entry in block


def apply_dpi(wine: Path, prefix: Path, dpi: str) -> None:
    """Set Wine's LogPixels (96 = 100%). Idempotent; empty leaves the prefix alone."""
    if not dpi.isdigit() or not 48 <= int(dpi) <= 480:
        if dpi:
            log(f"ignoring KEEL_DPI={dpi!r} (want 48-480)")
        return
    entry = f'"LogPixels"=dword:{int(dpi):08x}'
    targets = [
        ("user.reg", "Control Panel\\Desktop", r"HKCU\Control Panel\Desktop"),
        ("system.reg", "System\\CurrentControlSet\\Hardware Profiles\\Current\\Software\\Fonts",
         r"HKLM\System\CurrentControlSet\Hardware Profiles\Current\Software\Fonts"),
    ]
    env = wine_env(wine, prefix)
    for hive, section, key in targets:
        if hive == "system.reg":
            # CurrentControlSet is a link; Wine stores it under ControlSet001
            if reg_value_is(prefix, hive, section.replace("CurrentControlSet", "ControlSet001"), entry):
                continue
        elif reg_value_is(prefix, hive, section, entry):
            continue
        log(f"setting LogPixels={dpi} in {key}")
        subprocess.run(
            [str(wine), "reg", "add", key, "/v", "LogPixels", "/t", "REG_DWORD", "/d", dpi, "/f"],
            env=env, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )


def stage_native_dlls(prefix: Path, directory: Path) -> None:
    system32 = prefix / "drive_c" / "windows" / "system32"
    if not system32.is_dir():
        log(f"prefix has no system32 yet; cannot stage {directory}")
        return
    for dll in sorted(directory.glob("*.dll")):
        target = system32 / dll.name
        if target.is_file() and target.stat().st_size == dll.stat().st_size:
            continue
        shutil.copy2(dll, target)
        log(f"staged {dll.name}")


BRIDGE_STEAM_DIR = r"C:\Program Files (x86)\Steam"


def helpers_dir() -> Path:
    return tool_dir() / "helpers"


def runner_root(wine: Path) -> Path:
    """<prefix>/bin/wine -> <prefix>; follows the lib/wine/x86_64-unix/wine symlink layout too."""
    root = wine.parent.parent
    if (root / "lib" / "wine").is_dir():
        return root
    resolved = wine.resolve()
    for parent in resolved.parents:
        if (parent / "lib" / "wine").is_dir():
            return parent
    return root


def graphics_runner(graphics: str) -> tuple[Path | None, str]:
    """Runner variant for the graphics backend (KEEL_WINE_DXMT / KEEL_WINE_D3DMETAL), if set."""
    key = {"dxmt": "KEEL_WINE_DXMT", "d3dmetal": "KEEL_WINE_D3DMETAL"}.get(graphics)
    if not key:
        return None, ""
    raw = os.environ.get(key, "")
    if not raw:
        return None, ""
    path = Path(raw).expanduser()
    if executable(path):
        return path, key
    log(f"{key}={raw} is not executable; ignoring")
    return None, ""


def runner_has_dxmt(wine: Path) -> bool:
    lib = runner_root(wine) / "lib" / "wine"
    return (lib / "x86_64-windows" / "winemetal.dll").is_file() and \
        (lib / "x86_64-unix" / "winemetal.so").is_file()


def ensure_winemetal(prefix: Path, wine: Path) -> None:
    """DXMT's d3d11/dxgi import winemetal.dll; Wine needs a system32 placeholder to load it."""
    source = runner_root(wine) / "lib" / "wine" / "x86_64-windows" / "winemetal.dll"
    target = prefix / "drive_c" / "windows" / "system32" / "winemetal.dll"
    if target.is_file() and target.stat().st_size == source.stat().st_size:
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, target)
    log("staged system32/winemetal.dll")


def bridge_files(wine: Path) -> tuple[Path, Path]:
    lib = runner_root(wine) / "lib" / "wine"
    return lib / "x86_64-windows" / "lsteamclient.dll", lib / "x86_64-unix" / "lsteamclient.so"


def bridge_problems(wine: Path | None) -> list[str]:
    problems: list[str] = []
    if wine is None:
        return ["no Wine runner (set KEEL_WINE to a Wine 11 build with lsteamclient)"]
    dll, so = bridge_files(wine)
    if not dll.is_file():
        problems.append(f"missing {dll}")
    if not so.is_file():
        problems.append(f"missing {so}")
    if not (helpers_dir() / "keel_steam.exe").is_file():
        problems.append(f"missing {helpers_dir() / 'keel_steam.exe'}")
    if not mac_steamclient().is_file():
        problems.append(f"missing {mac_steamclient()}")
    return problems


def mac_steamclient() -> Path:
    forced = os.environ.get("KEEL_STEAMCLIENT_DYLIB", "")
    if forced:
        return Path(forced).expanduser()
    return (Path.home() / "Library" / "Application Support" / "Steam" / "Steam.AppBundle"
            / "Steam" / "Contents" / "MacOS" / "steamclient.dylib")


def dyld_paths() -> list[str]:
    raw = os.environ.get("KEEL_DYLD_PATH", "")
    paths = [p for p in raw.split(":") if p] if raw else [str(Path.home() / "opt" / "cxdeps-x86" / "lib")]
    return [str(Path(p).expanduser()) for p in paths]


def copy_if_changed(source: Path, target: Path) -> None:
    if target.is_file() and target.stat().st_size == source.stat().st_size \
            and target.stat().st_mtime >= source.stat().st_mtime:
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, target)
    log(f"staged {target.name}")


def stage_bridge(prefix: Path, wine: Path) -> None:
    steam_dir = prefix / "drive_c" / "Program Files (x86)" / "Steam"
    dll, _ = bridge_files(wine)
    copy_if_changed(dll, steam_dir / "steamclient64.dll")
    copy_if_changed(helpers_dir() / "keel_steam.exe", steam_dir / "keel_steam.exe")


def resolve_graphics(requested: str) -> str:
    if requested != "auto":
        return requested
    return "dxmt"


def dll_overrides(graphics: str, extra: str) -> str:
    table = {
        "dxmt": "d3d11,dxgi,d3d10core=n,b",
        "dxmt-runner": "d3d11,dxgi,d3d10core,winemetal=b",
        "dxvk": "d3d11,dxgi,d3d10core,d3d9=n,b",
        "d3dmetal": "d3d11,dxgi,d3d12,d3d10=b",
        "wined3d": "d3d11,dxgi,d3d12,d3d9=b",
    }
    parts = [table[graphics]] if graphics in table else []
    if extra:
        parts.append(extra)
    return ";".join(parts)


def to_windows_path(prefix: Path, unix_path: str) -> str:
    path = str(Path(unix_path).expanduser().resolve())
    drive_c = str((prefix / "drive_c").resolve())
    if path == drive_c or path.startswith(drive_c + os.sep):
        tail = path[len(drive_c) :].replace(os.sep, "\\")
        return "C:" + tail
    return "Z:" + path.replace(os.sep, "\\")


def to_unix_path(prefix: Path, windows_path: str) -> str:
    text = windows_path.replace("\\", "/")
    if len(text) >= 2 and text[1] == ":":
        letter = text[0].upper()
        tail = text[2:]
        if letter == "C":
            return str(prefix / "drive_c" / tail.lstrip("/"))
        if letter == "Z":
            return tail if tail.startswith("/") else "/" + tail
    return text


def refuse_dangerous(path: Path) -> Path:
    resolved = path.expanduser().resolve()
    home = Path.home().resolve()
    if resolved == home or resolved == Path("/") or home not in resolved.parents:
        raise SystemExit(f"refusing to delete {resolved}")
    return resolved


def command_args(argv: list[str]) -> list[str]:
    if len(argv) < 3:
        raise SystemExit("missing command")
    return argv[2:]


def prepare_and_launch(argv: list[str], applied: dict[str, str]) -> int:
    command = command_args(argv)
    runner_name = conf_get(applied, "KEEL_RUNNER", "runner", "auto")
    graphics = resolve_graphics(conf_get(applied, "KEEL_GRAPHICS", "graphics", "auto"))
    winver = conf_get(applied, "KEEL_WINVER", "winver", "win10")
    esync = conf_get(applied, "KEEL_ESYNC", "esync", "1")
    hud = conf_get(applied, "KEEL_HUD", "hud", "0")
    steamworks = conf_get(applied, "KEEL_STEAMWORKS", "steamworks", "direct")
    extra_dll = conf_get(applied, "KEEL_DLL", "dll", "")
    extra_args = conf_get(applied, "KEEL_ARGS", "args", "")

    variant, variant_key = graphics_runner(graphics)
    wine = variant if variant is not None else find_runner(runner_name)
    dxmt_runner = graphics == "dxmt" and variant is not None and runner_has_dxmt(variant)
    dry_run = os.environ.get("KEEL_DRY_RUN", "") == "1"
    prefix = prefix_path()
    if steamworks == "prefix" and steam_exe_path().is_file():
        prefix = steam_client_prefix()

    log(f"======== Keel {VERSION}  {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S')}Z")
    log(f"verb: {argv[1]}")
    log(f"appid: {appid() or '(none)'}")
    log(f"graphics: {graphics}")
    log(f"runner request: {runner_name}")
    if wine is None:
        log("no Wine runner found. Install CrossOver, Game Porting Toolkit, Whisky, or Homebrew wine.")
        for candidate in family_candidates(runner_name):
            log(f"  missing {candidate}")
        return 1
    log(f"wine: {wine} ({'from ' + variant_key if variant_key else 'KEEL_WINE/runner'})")
    log(f"prefix: {prefix}")

    bridge = steamworks == "bridge"
    if bridge:
        problems = bridge_problems(wine)
        if problems:
            log("steamworks=bridge is not ready:")
            for problem in problems:
                log(f"  {problem}")
            return 1
        extra = dyld_paths()
        current = [p for p in os.environ.get("DYLD_FALLBACK_LIBRARY_PATH", "").split(":") if p]
        fallback = extra + [p for p in current if p not in extra]
        for default in ("/usr/local/lib", "/usr/lib"):
            if default not in fallback:
                fallback.append(default)
        os.environ["DYLD_FALLBACK_LIBRARY_PATH"] = ":".join(fallback)
        aid_env = appid()
        if aid_env:
            os.environ.setdefault("SteamAppId", aid_env)
            os.environ.setdefault("SteamGameId", aid_env)

    if dry_run:
        if graphics == "dxmt" and dxmt_runner:
            backend = "runner builtins (d3d11,dxgi,d3d10core=b) + system32/winemetal.dll"
        elif graphics == "dxmt":
            backend = f"native staging from {dxmt_dll_dir()}"
        else:
            backend = dll_overrides(graphics, "")
        overrides = dll_overrides("dxmt-runner" if dxmt_runner else graphics, extra_dll)
        if bridge:
            overrides = ";".join(part for part in (overrides, "steamclient64=n,b") if part)
        launch = list(command) + (extra_args.split() if extra_args else [])
        if bridge:
            launch = [BRIDGE_STEAM_DIR + r"\keel_steam.exe", *launch]
        log(f"dry run: graphics={graphics} via {backend}")
        log(f"dry run: WINEDLLOVERRIDES={overrides}")
        log("dry run: command: " + " ".join([str(wine), *launch]))
        log("dry run: no prefix changes, Wine not started")
        return 0

    ensure_prefix(wine, prefix, winver)
    retina = conf_get(applied, "KEEL_RETINA", "retina", "1")
    if retina in ("0", "1"):
        apply_retina(wine, prefix, retina == "1")
    apply_dpi(wine, prefix, conf_get(applied, "KEEL_DPI", "dpi", ""))
    env = wine_env(wine, prefix)
    if esync == "1":
        env["WINEESYNC"] = "1"
        # CrossOver-derived runners (incl. Keel's Wine 11 build) implement fast sync as
        # mach-port "msync"; without it every wait/event is a wineserver round trip
        # (~8 us vs ~0.1 us), which starves multithreaded video decoders (P5R's CRI Mana).
        env.setdefault("WINEMSYNC", "1")
    env["ROSETTA_ADVERTISE_AVX"] = "1"
    env["MTL_HUD_ENABLED"] = "1" if hud == "1" else "0"
    env["DXMT_LOG_LEVEL"] = "info" if hud == "1" else "none"

    if graphics == "dxmt" and dxmt_runner:
        ensure_winemetal(prefix, wine)
        log(f"dxmt: runner builtins ({runner_root(wine)})")
    elif graphics == "dxmt":
        dlls = dxmt_dll_dir()
        if dlls is None:
            log("DXMT not installed; falling back to WineD3D. Run: keel fetch-dxmt")
            graphics = "wined3d"
        else:
            stage_native_dlls(prefix, dlls)
            log(f"dxmt: {dlls}")
    elif graphics == "dxvk":
        dxvk = support_dir() / "dxvk" / "x64"
        if (dxvk / "d3d11.dll").is_file():
            stage_native_dlls(prefix, dxvk)
        else:
            log("DXVK macOS build not in ~/Library/Application Support/Keel/dxvk/x64; using WineD3D")
            graphics = "wined3d"
    elif graphics == "d3dmetal":
        log("D3DMetal uses the runner's builtin. CrossOver or Game Porting Toolkit is required.")

    overrides = dll_overrides("dxmt-runner" if dxmt_runner else graphics, extra_dll)
    if bridge:
        stage_bridge(prefix, wine)
        overrides = ";".join(part for part in (overrides, "steamclient64=n,b") if part)
        log(f"steamworks: bridge (lsteamclient -> {mac_steamclient()})")
        log(f"DYLD_FALLBACK_LIBRARY_PATH={env.get('DYLD_FALLBACK_LIBRARY_PATH', '')}")
    env["WINEDLLOVERRIDES"] = overrides

    launch = list(command)
    aid = appid()
    if steamworks == "prefix" and aid:
        steam_exe = steam_exe_path()
        if steam_exe.is_file():
            ensure_shared_library(steam_exe.parent)
            launch = [str(steam_exe), "-applaunch", aid]
            log("steamworks: Windows Steam client -applaunch")
        else:
            log("steamworks=prefix but Windows Steam is not installed. Run: keel setup-steam")
    if extra_args:
        launch.extend(extra_args.split())
    if bridge:
        launch = [BRIDGE_STEAM_DIR + r"\keel_steam.exe", *launch]

    log("command: " + " ".join(launch))
    wine_log_setting = conf_get(applied, "KEEL_WINE_LOG", "wine_log", "1")
    wine_log = None
    if wine_log_setting == "1" and os.environ.get("STEAM_COMPAT_DATA_PATH"):
        log_path = Path(os.environ["STEAM_COMPAT_DATA_PATH"]) / "wine.log"
        try:
            wine_log = open(log_path, "w", encoding="utf-8")
            log(f"wine output: {log_path} (WINEDEBUG={env.get('WINEDEBUG', '')})")
        except OSError:
            wine_log = None
    try:
        proc = subprocess.Popen([str(wine), *launch], env=env, stdout=wine_log, stderr=wine_log)
        code = proc.wait()
    finally:
        if wine_log is not None:
            wine_log.close()
    wineserver = wine.parent / "wineserver"
    if executable(wineserver):
        subprocess.run([str(wineserver), "-w"], env=env, check=False)
    log(f"exit: {code}")
    return code


def ensure_shared_library(steam_install: Path) -> None:
    """Point Windows Steam at the Mac client's library folder, once."""
    mac_library = os.environ.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or str(
        Path.home() / "Library" / "Application Support" / "Steam"
    )
    folder = steam_install / "steamapps"
    folder.mkdir(parents=True, exist_ok=True)
    vdf = folder / "libraryfolders.vdf"
    win_path = "Z:" + str(Path(mac_library).resolve()).replace("/", "\\")
    if vdf.is_file():
        current = vdf.read_text(encoding="utf-8", errors="replace")
        if win_path in current:
            return
        log("libraryfolders.vdf already exists; leaving it untouched")
        return
    escaped = win_path.replace("\\", "\\\\")
    vdf.write_text(
        '"libraryfolders"\n{\n'
        '\t"0"\n\t{\n\t\t"path"\t\t"C:\\\\Program Files (x86)\\\\Steam"\n\t}\n'
        f'\t"1"\n\t{{\n\t\t"path"\t\t"{escaped}"\n\t}}\n'
        "}\n",
        encoding="utf-8",
    )
    log(f"linked Windows Steam library to {mac_library}")


def safe_extract(archive: tarfile.TarFile, destination: Path) -> None:
    destination = destination.resolve()
    for member in archive.getmembers():
        target = (destination / member.name).resolve()
        if destination != target and destination not in target.parents:
            raise SystemExit(f"refusing archive path {member.name}")
    archive.extractall(destination)


def fetch_dxmt() -> int:
    destination = support_dir() / "dxmt"
    destination.mkdir(parents=True, exist_ok=True)
    request = urllib.request.Request(
        "https://api.github.com/repos/3Shain/dxmt/releases/latest",
        headers={"User-Agent": "Keel", "Accept": "application/vnd.github+json"},
    )
    with urllib.request.urlopen(request, timeout=60) as response:
        payload = json.load(response)
    assets = payload.get("assets") or []
    chosen = None
    for asset in assets:
        name = asset.get("name", "").lower()
        if name.endswith((".tar.gz", ".tgz", ".zip")) and any(
            token in name for token in ("mac", "osx", "darwin", "macos")
        ):
            chosen = asset
            break
    if chosen is None:
        for asset in assets:
            if str(asset.get("name", "")).endswith(".tar.gz"):
                chosen = asset
                break
    if chosen is None:
        log("DXMT release has no archive asset")
        return 1
    url = chosen["browser_download_url"]
    archive_path = destination / chosen["name"]
    log(f"downloading {url}")
    urllib.request.urlretrieve(url, archive_path)
    extract_root = destination / "src"
    if extract_root.exists():
        shutil.rmtree(extract_root)
    extract_root.mkdir(parents=True)
    if archive_path.suffix == ".zip":
        import zipfile

        with zipfile.ZipFile(archive_path) as archive:
            archive.extractall(extract_root)
    else:
        with tarfile.open(archive_path, "r:*") as archive:
            safe_extract(archive, extract_root)
    found = sorted(extract_root.rglob("d3d11.dll"))
    dll = next((d for d in found if d.parent.name in ("x86_64-windows", "x64")), None)
    if dll is None:
        dll = next((d for d in found if "i386" not in str(d) and "x32" not in str(d)), found[0] if found else None)
    if dll is None:
        log("archive did not contain d3d11.dll")
        return 1
    (destination / "location.txt").write_text(str(dll.parent) + "\n", encoding="utf-8")
    log(f"DXMT ready at {dll.parent}")
    return 0


def setup_steam() -> int:
    wine = find_runner(os.environ.get("KEEL_RUNNER", "auto"))
    if wine is None:
        log("no Wine runner found")
        return 1
    prefix = support_dir() / "steam-client" / "pfx"
    ensure_prefix(wine, prefix, os.environ.get("KEEL_WINVER", "win10"))
    installer = support_dir() / "cache" / "SteamSetup.exe"
    installer.parent.mkdir(parents=True, exist_ok=True)
    if not installer.is_file():
        url = "https://cdn.akamai.steamstatic.com/client/installer/SteamSetup.exe"
        log(f"downloading {url}")
        urllib.request.urlretrieve(url, installer)
    env = wine_env(wine, prefix)
    log("launching the official Windows Steam installer")
    return subprocess.run([str(wine), str(installer)], env=env, check=False).returncode


def doctor() -> int:
    steam = Path.home() / "Library" / "Application Support" / "Steam"
    macos = steam / "Steam.AppBundle" / "Steam" / "Contents" / "MacOS"
    cfg = macos / "steam_dev.cfg"
    switch = False
    if cfg.is_file():
        switch = "sSteamCmdForcePlatformType" in cfg.read_text(encoding="utf-8", errors="replace")
    tool = steam / "compatibilitytools.d" / "keel-proton" / "keel"
    lines = [
        f"Keel {VERSION}",
        f"Steam: {'found' if steam.is_dir() else 'not installed'}",
        f"Tool files: {'installed' if tool.is_file() else 'not installed'}",
        f"Compatibility menu: not shown on Mac Steam. Use Launch Options.",
        f"Windows depot switch: {'on' if switch else 'off'}",
        f"Python: {sys.version.split()[0]}",
    ]
    forced = os.environ.get("KEEL_WINE", "")
    if forced:
        ok = forced_runner() is not None
        lines.append(f"KEEL_WINE (forces every launch): {forced}{'' if ok else '  [NOT EXECUTABLE]'}")
    saved = os.environ.pop("KEEL_WINE", None)
    try:
        for name in ("crossover", "gptk", "whisky", "wine"):
            found = find_runner(name)
            lines.append(f"{name}: {found if found else 'not found'}")
    finally:
        if saved is not None:
            os.environ["KEEL_WINE"] = saved
    problems = bridge_problems(find_runner("auto"))
    lines.append("Steamworks bridge: " + ("ready" if not problems else "not ready"))
    for problem in problems:
        lines.append(f"  {problem}")
    dlls = dxmt_dll_dir()
    lines.append(f"DXMT: {dlls if dlls else 'not installed (keel fetch-dxmt)'}")
    apps = sorted((support_dir() / "apps").glob("*.conf"))
    if apps:
        lines.append("Per-app graphics:")
    for conf in apps:
        values = load_conf(conf)
        graphics = values.get("KEEL_GRAPHICS", values.get("graphics", "auto (default)"))
        line = f"  {conf.stem}: {graphics}"
        variant = values.get({"dxmt": "KEEL_WINE_DXMT", "d3dmetal": "KEEL_WINE_D3DMETAL"}.get(graphics, ""), "")
        if variant:
            line += f"  runner {variant}"
        lines.append(line)
    text = "\n".join(lines)
    print(text)
    return 0


GRAPHICS_CHOICES = ("d3dmetal", "dxmt", "dxvk", "wined3d", "auto")


def graphics_command(argv: list[str]) -> int:
    if len(argv) < 3 or not argv[2].isdigit():
        sys.stderr.write("usage: keel graphics <appid> [" + "|".join(GRAPHICS_CHOICES) + "]\n")
        return 1
    conf = support_dir() / "apps" / f"{argv[2]}.conf"
    values = load_conf(conf)
    if len(argv) < 4:
        print(values.get("KEEL_GRAPHICS", values.get("graphics", "auto")))
        return 0
    choice = argv[3].lower()
    if choice not in GRAPHICS_CHOICES:
        sys.stderr.write(f"unknown backend {choice}; choose one of {', '.join(GRAPHICS_CHOICES)}\n")
        return 1
    lines = conf.read_text(encoding="utf-8").splitlines() if conf.is_file() else []
    backup = conf.with_name(conf.name + ".bak")
    if conf.is_file() and not backup.exists():
        shutil.copy2(conf, backup)
    out, done = [], False
    for line in lines:
        key = line.split("=", 1)[0].strip() if "=" in line and not line.lstrip().startswith("#") else ""
        if key in ("KEEL_GRAPHICS", "graphics"):
            if not done:
                out.append(f"KEEL_GRAPHICS={choice}")
                done = True
            continue
        out.append(line)
    if not done:
        out.append(f"KEEL_GRAPHICS={choice}")
    conf.parent.mkdir(parents=True, exist_ok=True)
    conf.write_text("\n".join(out) + "\n", encoding="utf-8")
    print(f"{argv[2]}: KEEL_GRAPHICS={choice}  ({conf})")
    return 0


def destroy_prefix() -> int:
    target = refuse_dangerous(data_path())
    if not (target / "pfx").exists() and not (target / "version").exists():
        log(f"nothing to remove at {target}")
        return 0
    shutil.rmtree(target)
    log(f"removed {target}")
    return 0


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        sys.stderr.write(USAGE)
        return 0 if len(argv) > 1 else 1
    verb = argv[1]
    if verb == "version":
        print(VERSION)
        return 0
    if verb == "doctor":
        apply_config()
        return doctor()
    if verb == "graphics":
        return graphics_command(argv)
    if verb == "fetch-dxmt":
        return fetch_dxmt()
    if verb == "setup-steam":
        apply_config()
        return setup_steam()
    if verb in ("run", "waitforexitandrun", "runinprefix", "destroyprefix", "getcompatpath", "getnativepath"):
        ensure_compat_env()
    applied = apply_config()
    if verb == "destroyprefix":
        return destroy_prefix()
    if verb == "getcompatpath":
        if len(argv) < 3:
            return 1
        print(to_windows_path(prefix_path(), argv[2]))
        return 0
    if verb == "getnativepath":
        if len(argv) < 3:
            return 1
        print(to_unix_path(prefix_path(), argv[2]))
        return 0
    if verb in ("run", "waitforexitandrun", "runinprefix"):
        return prepare_and_launch(argv, applied)
    sys.stderr.write(USAGE)
    return 1


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except KeyboardInterrupt:
        raise SystemExit(130)
    except BrokenPipeError:
        raise SystemExit(0)
